#!/bin/sh
#
# PROVIDE: pinea
# REQUIRE: LOGIN
# KEYWORD: shutdown

. /etc/rc.subr

name="pinea"
rcvar=pinea_enable

: ${pinea_enable:="NO"}

app_dir="/usr/local/pinea.server/current"
log_dir="/usr/local/pinea.server/logs"
log_file="${log_dir}/pinea.log"
pidfile="/usr/local/pinea.server/pinea.pid"

host="0.0.0.0"
port="4000"

command="/usr/sbin/daemon"
procname="/usr/local/bin/python3"
command_args="-u pineaserver /usr/local/bin/python3 -m uvicorn app.main:app --app-dir ${app_dir}/backend --host ${host} --port ${port}"

load_rc_config $name
run_rc_command "$1"